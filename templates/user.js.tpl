// Generated by multi-identity-firefox on every launch.
// Anything changed in about:config or the settings UI is reverted at next start.

user_pref("intl.accept_languages", "__LANGUAGE__,en;q=0.8");
user_pref("intl.locale.requested", "__LOCALE__");
user_pref("intl.regional_prefs.use_os_locales", false);

// The web-visible timezone comes from the TZ variable exported by the launcher,
// which Firefox picks up through ICU. No extension is involved.
// __TIMEZONE_NOTE__

// resistFingerprinting stays off: it forces the web-visible timezone to UTC,
// which would contradict this identity's region. __FPP_SUMMARY__
user_pref("privacy.resistFingerprinting", false);
__FPP_BLOCK__

__GEO_BLOCK__

// WebRTC enumerates host addresses through its own path, so it is the usual way
// a real IP escapes an otherwise proxied profile.
user_pref("media.peerconnection.ice.proxy_only", true);
user_pref("media.peerconnection.ice.default_address_only", true);

// Speculative connections resolve names outside the proxied request path.
user_pref("network.dns.disablePrefetch", true);
user_pref("network.predictor.enabled", false);

// Tracking protection. Firefox Standard currently includes Total Cookie Protection.
user_pref("privacy.trackingprotection.enabled", true);
user_pref("privacy.trackingprotection.socialtracking.enabled", true);

// Keep Firefox Account sync off unless explicitly enabled later.
user_pref("identity.fxaccounts.enabled", false);

// Reduce telemetry for these isolated profiles.
user_pref("datareporting.healthreport.uploadEnabled", false);
user_pref("datareporting.policy.dataSubmissionEnabled", false);
user_pref("toolkit.telemetry.enabled", false);
user_pref("app.shield.optoutstudies.enabled", false);

// Per-identity download folder.
user_pref("browser.download.useDownloadDir", true);
user_pref("browser.download.dir", "__DOWNLOAD_DIR__");

// Avoid password-save prompts. Any saved credentials remain local to the profile.
user_pref("signon.rememberSignons", false);

user_pref("geo.enabled", true);
__PLATFORM_BLOCK__
__PROXY_BLOCK__
